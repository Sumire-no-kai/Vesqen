<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- M7-1: reads a USB audio device's descriptors, started over adb. It claims no interface
             and sends no audio. -->
        <activity
            android:name="io.github.sumirenokai.vesqen.usb.UsbDescriptorDumpActivity"
            android:exported="true"
            android:label="USB descriptors" />
        <!-- M7-2: claims a USB audio device and, only when asked for play, sends a test signal.
             Started over adb. -->
        <activity
            android:name="io.github.sumirenokai.vesqen.usb.UsbStreamProbeActivity"
            android:exported="true"
            android:label="USB probe" />
        <!-- M7-2: a real ExoPlayer on the own USB path, driven by a fixed script. Started over adb. -->
        <activity
            android:name="io.github.sumirenokai.vesqen.usb.chain.UsbChainProbeActivity"
            android:exported="true"
            android:label="USB chain" />
        <service
            android:name="io.github.sumirenokai.vesqen.usb.chain.UsbChainKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- Device tests only: a documents provider whose answers the test sets (#191 D3, D13). It
             has no roots, so the system file picker lists nothing from it. -->
        <provider
            android:name="io.github.sumirenokai.vesqen.testing.FakeDocumentsProvider"
            android:authorities="${applicationId}.fake-documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>

</manifest>
