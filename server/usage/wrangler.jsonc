{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vesqen-usage",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  // Owner supplies account_id and custom domain in an ignored local config before deployment.
  "routes": [],
  "observability": { "enabled": false, "logs": { "enabled": false }, "traces": { "enabled": false } },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "vesqen-usage",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [
    { "name": "USAGE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "REPORT_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "REPORT_RETENTION_DAYS": "7",
    "AGGREGATE_RETENTION_DAYS": "90",
    "UPDATE_MANIFEST_BASE_URL": "",
    // "owner/repo" whose release APK download counts are read once a day; empty turns it off.
    "DOWNLOAD_COUNTS_REPO": "",
    // #96: "closed" stops an endpoint at once (503, nothing read or stored).
    "USAGE_INGEST": "open",
    "REPORT_INGEST": "open"
  },
  "triggers": { "crons": ["0 * * * *"] }
}
